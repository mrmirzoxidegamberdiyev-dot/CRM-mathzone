# Database Configuration
POSTGRES_DB=mathzone_crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_secure_password_here
POSTGRES_PORT=5432

# Backend Configuration
BACKEND_PORT=3000
NODE_ENV=development

# JWT Configuration (MUST CHANGE IN PRODUCTION!)
JWT_SECRET=CHANGE-THIS-TO-RANDOM-64-CHARACTER-STRING-IN-PRODUCTION
JWT_REFRESH_SECRET=CHANGE-THIS-TO-ANOTHER-RANDOM-64-CHARACTER-STRING

# CORS Configuration
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Security Configuration
BCRYPT_SALT_ROUNDS=12

# Logging Configuration
LOG_LEVEL=info
